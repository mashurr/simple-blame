{
    "name": "simple-blame",
    "displayName": "Simple Blame",
    "description": "A simple extension to toggle a whole-file Git blame view.",
    "version": "0.0.4",
    "publisher": "mashurr",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/mashurr/simple-blame.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "simple-blame.toggle",
                "title": "Simple Blame: Toggle Inline Blame"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.25.1"
    },
    "license": "MIT"
}
